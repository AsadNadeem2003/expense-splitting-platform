# Logs
logs
*.log
npm-debug.log*

# Runtime data & System files
pids
*.pid
*.seed
*.pid.lock
.DS_Store
.vscode/

# Global Dependency & Build Directories
node_modules/
dist/
build/
.cache/

# --- BACKEND EXPLICIT RULES ---
# Keeps backend specific modules and builds safe
backend/node_modules/
backend/dist/
backend/build/

# Critical: Prevent pushing backend secrets
backend/.env
backend/.env.local
backend/.env.production
# Ensure the example schema is always tracked
!backend/.env.example

# --- PRISMA RULES ---
# If you use SQLite locally, ignore the dev database file
backend/prisma/*.db
backend/prisma/*.db-journal
